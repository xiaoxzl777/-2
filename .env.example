# 复制为 .env 后填写。仓库只提交本示例文件，.env 永不提交。

APP_ENV=dev

# ---- MySQL ----
# 本机 MySQL：改成你的密码；compose 部署时 backend 容器内会被覆盖为 mysql:3306
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/resume_ai?charset=utf8mb4
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=resume_ai

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 数据目录（上传文件、Chroma、评测输出）----
DATA_DIR=../data

# ---- 认证 ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# ---- 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
# 本机配了 HTTP(S)_PROXY 时，国内模型服务直连更快；需要走代理再改成 true
# LLM_USE_SYSTEM_PROXY=false

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- 业务阈值（有默认值，通常不用改）----
# SCREEN_THRESHOLD=60
# DIAGNOSE_COST_LIMIT=0.05
# INTERVIEW_COST_LIMIT=0.3
